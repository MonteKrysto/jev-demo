{
  "name": "jev-rcm-poc",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --import tsx --watch apps/api/server.ts",
    "dev:worker": "node --env-file-if-exists=.env --import tsx --watch apps/worker/server.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file-if-exists=.env --import tsx apps/api/server.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "npm run build && playwright test",
    "evaluate": "node --env-file-if-exists=.env --import tsx scripts/evaluate.ts",
    "benchmark": "node --env-file-if-exists=.env --import tsx scripts/benchmark.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "worker": "node --env-file-if-exists=.env --import tsx apps/worker/server.ts",
    "worker:health": "node --env-file-if-exists=.env --import tsx scripts/worker-health.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "db:export": "node --env-file-if-exists=.env --import tsx scripts/export-runs.ts",
    "db:import": "node --env-file-if-exists=.env --import tsx scripts/import-runs.ts",
    "test:native": "node --env-file-if-exists=.env --import tsx scripts/native-smoke.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@fastify/static": "^10.1.6",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@tanstack/react-query": "5.104.1",
    "@typesafe-ai/sdk": "0.6.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.6.1",
    "lucide-react": "1.55.0",
    "openai": "^6.0.0",
    "pg": "^8.16.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
