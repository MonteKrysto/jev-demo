# Default demo mode needs no API keys. Live modes are selected per run in the UI.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_BASE_URL=https://api.typesafe.ai
# OPENAI_API_KEY is also used for an OpenAI-compatible server via LLM_BASE_URL.
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_BASE_URL=https://api.openai.com/v1
CONFIDENCE_THRESHOLD=0.7
MAX_STEPS=12
MAX_PAYER_CALLS=2
PORT=3001
HOST=127.0.0.1
# Blank means embedded, disk-backed PGlite. Docker sets DATABASE_URL itself.
DATABASE_URL=
DATA_DIR=.data/postgres

# Docker host port. Development serves Vite here and proxies the internal API.
APP_PORT=3001
